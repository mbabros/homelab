# AppFlowy Cloud Configuration
APPFLOWY_BASE_URL=https://appflowy.mbabros.com
APPFLOWY_GOTRUE_BASE_URL=https://appflowy.mbabros.com/gotrue
APPFLOWY_WS_BASE_URL=wss://appflowy.mbabros.com/ws/v2
SERVICE_URL_ADMIN=https://appflowy.mbabros.com
SERVICE_URL_APPFLOWYWEB=https://appflowy.mbabros.com

# PostgreSQL Database Configuration
SERVICE_USER_POSTGRES=appflowy
SERVICE_PASSWORD_POSTGRES=your_postgres_password_here
POSTGRES_DB=appflowy

# Auth & GoTrue Configuration
SERVICE_PASSWORD_JWT=your_64_character_hex_jwt_secret_here
SERVICE_PASSWORD_ADMIN=your_gotrue_admin_password_here
GOTRUE_ADMIN_EMAIL=admin@mbabros.com

# MinIO Object Storage Configuration
SERVICE_USER_MINIO=minioadmin
SERVICE_PASSWORD_MINIO=your_minio_password_here
APPFLOWY_S3_BUCKET=appflowy
APPFLOWY_S3_REGION=us-east-1

# Optional AI Configuration
AI_OPENAI_API_KEY=
DEFAULT_AI_MODEL=gpt-4o-mini

# SMTP Mailer Configuration
APPFLOWY_MAILER_SMTP_HOST=smtp.gmail.com
APPFLOWY_MAILER_SMTP_PORT=465
APPFLOWY_MAILER_SMTP_USERNAME=your_smtp_username@gmail.com
APPFLOWY_MAILER_SMTP_EMAIL=admin@mbabros.com
APPFLOWY_MAILER_SMTP_PASSWORD=your_app_password
APPFLOWY_MAILER_SMTP_TLS_KIND=wrapper
GOTRUE_SMTP_HOST=smtp.gmail.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=your_smtp_username@gmail.com
GOTRUE_SMTP_PASS=your_app_password
GOTRUE_SMTP_ADMIN_EMAIL=admin@mbabros.com
